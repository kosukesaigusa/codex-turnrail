[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# Preserve the verbatim upstream V8 license notices.
skip = .build,.cache,.venv,tmp,dist,node_modules,.git*,vendor,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,*/packaging/licenses/V8-NOTICES.txt
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH,inout
